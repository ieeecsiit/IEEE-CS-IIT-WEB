# Payload CMS of the IEEE Student Branch site. Events tagged "CS" (and published
# to Projects) and published blog posts are loaded from its public read-only API:
# <CMS_URL>/api/events and <CMS_URL>/api/blogs
CMS_URL=https://ieee.iit.ac.lk

# Absolute base URL of this site, used for social preview images.
NEXT_PUBLIC_SITE_URL=https://csieeeiit.cloud

# Shared secret for POST /api/revalidate, which the CMS calls after each CS event
# or blog post change so it shows here immediately. Must match
# CS_SITE_REVALIDATE_SECRET on the CMS. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=
