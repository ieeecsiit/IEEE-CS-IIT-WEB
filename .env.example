# All values are read at build time; on Cloudflare Pages, set them under
# Settings > Environment variables.

# Payload CMS of the IEEE Student Branch site. CS events (published to Projects)
# and published blog posts are loaded from its public read-only API at build time:
# <CMS_URL>/api/events and <CMS_URL>/api/blogs
CMS_URL=https://ieee.iit.ac.lk

# Absolute base URL of this site, used for canonical URLs, social previews, the
# sitemap, robots.txt, llms.txt and JSON-LD. Defaults to https://csieeeiit.cloud.
NEXT_PUBLIC_SITE_URL=https://csieeeiit.cloud

# Google Analytics 4 measurement ID. Only loaded in production builds.
# Defaults to G-6DZN8Z6LM0; set it to an empty value to turn analytics off.
NEXT_PUBLIC_GA_ID=G-6DZN8Z6LM0

# Optional. Google Search Console "HTML tag" verification token (the content="…" value).
GOOGLE_SITE_VERIFICATION=
