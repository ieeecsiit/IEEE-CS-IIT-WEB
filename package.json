{
  "name": "ieee-cs-iit-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler pages dev public --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply ieee-cs-forms --local",
    "db:migrate:remote": "wrangler d1 migrations apply ieee-cs-forms --remote",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "lint": "eslint",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261128.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.169.0"
  }
}
